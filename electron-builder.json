{
  "appId": "com.zeinfotech.pos",
  "productName": "ZeInfoTech POS",
  "copyright": "Copyright © 2025 ZeInfoTech",
  "asar": true,
  "npmRebuild": false,
  "afterPack": "scripts/afterPack-set-icon.cjs",
  "asarUnpack": [
    "**/server/**/*",
    "**/node_modules/@serialport/**/*",
    "**/node_modules/serialport/**/*"
  ],
  "compression": "store",

  "electronFuses": {
    "runAsNode": false,
    "enableCookieEncryption": true,
    "enableNodeOptionsEnvironmentVariable": false,
    "enableNodeCliInspectArguments": false,
    "enableEmbeddedAsarIntegrityValidation": true,
    "onlyLoadAppFromAsar": true,
    "grantFileProtocolExtraPrivileges": true
  },

  "directories": {
    "output": "dist-electron",
    "buildResources": "electron"
  },

  "files": [
    "dist/**/*",
    "electron/**/*",
    "!electron/icon.png",
    "!electron/vc_redist.x64.exe"
  ],

  "extraResources": [
    {
      "from": "server/",
      "to": "server/",
      "filter": [
        "**/*",
        "!.env",
        "!.env.*",
        "!node_modules/.cache",
        "!node_modules/.bin",
        "!node_modules/**/*.md",
        "!node_modules/**/*.map",
        "!node_modules/**/*.ts",
        "!node_modules/**/test",
        "!node_modules/**/tests",
        "!scripts/**",
        "!**/*.log",
        "!**/*.txt"
      ]
    },
    {
      "from": "server/node_modules/",
      "to": "server/node_modules/",
      "filter": [
        "**/*",
        "!.cache",
        "!.bin",
        "!**/*.md",
        "!**/*.map",
        "!**/*.ts",
        "!**/test",
        "!**/tests"
      ]
    },
    {
      "from": "node-portable/node.exe",
      "to": "node.exe"
    },
    {
      "from": "mongodb-portable/mongod.exe",
      "to": "mongodb-portable/mongod.exe"
    },
    {
      "from": "electron/icon.png",
      "to": "icon.png"
    }
  ],

  "win": {
    "forceCodeSigning": false,
    "signAndEditExecutable": false,
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "zip",
        "arch": ["x64"]
      }
    ]
  },

  "nsis": {
    "oneClick": false,
    "perMachine": true,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "ZeInfoTech POS",
    "deleteAppDataOnUninstall": false,
    "runAfterFinish": true,
    "unicode": true,
    "include": "electron/installer.nsh"
  }
}
