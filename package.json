{
  "name": "zeinfotech-pos",
  "productName": "ZeInfoTech POS",
  "description": "ZeInfoTech Point of Sale Desktop Application",
  "author": "ZeInfoTech",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm run sync\" \"wait-on http://127.0.0.1:3030/health && vite\"",
    "build": "vite build",
    "preview": "vite preview",
    "sync": "node server/index.js",
    "test": "playwright test tests/electron.spec.js tests/full-suite.spec.js",
    "test:deep": "playwright test tests/deep.spec.js",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "electron:start": "wait-on http://localhost:5173 && electron .",
    "electron:dev": "concurrently --kill-others-on-fail \"vite\" \"npm run electron:start\"",
    "electron:only": "electron .",
    "electron:build": "cross-env WIN_CODE_SIGN_SKIP_EXTRACT=true node scripts/build-release.cjs",
    "electron:pack": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --x64 --dir"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/user-event": "^14.6.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^29.4.6",
    "electron-builder": "^26.8.1",
    "electron-packager": "^17.1.2",
    "electron-winstaller": "^5.4.0",
    "happy-dom": "^20.9.0",
    "jsdom": "^27.0.1",
    "vite": "^7.3.1",
    "vitest": "^4.1.6",
    "wait-on": "^9.0.5"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "node-machine-id": "^1.1.12"
  }
}
